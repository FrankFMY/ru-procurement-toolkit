{
  "name": "ru-procurement-toolkit",
  "version": "0.1.0",
  "description": "Framework-neutral TypeScript utilities for Russian procurement and tender products.",
  "author": "Artyom Pryanishnikov <Pryanishnikovartem@gmail.com> (https://github.com/FrankFMY)",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrankFMY/ru-procurement-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/FrankFMY/ru-procurement-toolkit/issues"
  },
  "homepage": "https://github.com/FrankFMY/ru-procurement-toolkit#readme",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir dist --target node",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  },
  "packageManager": "bun@1.3.13",
  "keywords": [
    "procurement",
    "tender",
    "zakupki",
    "eis",
    "44-fz",
    "223-fz",
    "typescript"
  ]
}
