{
  "name": "ru-procurement-toolkit",
  "version": "0.1.1",
  "description": "Framework-neutral TypeScript utilities for Russian procurement and tender products.",
  "author": "Artem Prianishnikov <Pryanishnikovartem@gmail.com> (https://github.com/FrankFMY)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrankFMY/ru-procurement-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/FrankFMY/ru-procurement-toolkit/issues"
  },
  "homepage": "https://github.com/FrankFMY/ru-procurement-toolkit#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "build": "rm -rf dist && bun build ./src/index.ts --outdir dist --target node && tsc -p tsconfig.build.json",
    "package:check": "node scripts/verify-package-contract.mjs",
    "prepublishOnly": "bun run format:check && bun run check && bun test && bun run build && bun run package:check",
    "format": "prettier --write \"**/*.{ts,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json,md,yml,yaml}\""
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  },
  "packageManager": "bun@1.3.13",
  "keywords": [
    "procurement",
    "tender",
    "zakupki",
    "eis",
    "44-fz",
    "223-fz",
    "typescript"
  ]
}
